# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# Google AI Studio (Gemini) — powers the deterministic extract → SWOT analysis steps.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Anthropic — powers the Claude Agent SDK web-research step.
# Optional: if unset, research falls back to Gemini's Google Search grounding.
# Get one at https://console.anthropic.com  (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Local SQLite path (dev). Production target is Supabase Postgres (see README).
CONSULTOS_DB_PATH=./consultos.db
